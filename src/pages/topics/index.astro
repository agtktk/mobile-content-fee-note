---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import {publishedArticles} from '../../lib/content';
import {site} from '../../data/site';
const articles=await publishedArticles();
---
<Base title={"주제별 보기"} description={site.keyword+' '+"이 사이트가 다루는 질문의 범위와 읽는 순서를 안내합니다."} crumbs={[{name:"주제별 보기",url:"/topics/"}]}><div class="page-intro"><p class="eyebrow">READING INDEX</p><h1>주제별 보기</h1><p>{site.intro}</p></div><section><h2>이 주제에서 확인할 가이드</h2><div class="articles-grid">{articles.map(article=><ArticleCard article={article}/>)}</div><p><a href="/guide/">확인 질문을 정리하는 순서</a> · <a href="/topics/basics/">주제의 범위</a> · <a href="/about/">편집 원칙</a></p></section></Base>