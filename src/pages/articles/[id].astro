---
import {render} from 'astro:content';
import Base from '../../layouts/Base.astro';
import ContactCard from '../../components/ContactCard.astro';
import {site} from '../../data/site';
import {publishedArticles,articleUrl} from '../../lib/content';
export async function getStaticPaths(){return (await publishedArticles()).map(article=>({params:{id:article.id},props:{article}}));}
const {article}=Astro.props;const a=article.data;const {Content}=await render(article);
const schema={'@type':'Article',headline:a.title,description:a.description,datePublished:a.publishedAt+'T00:00:00+09:00',dateModified:a.updatedAt+'T00:00:00+09:00',inLanguage:'ko-KR',author:{'@type':'Organization',name:site.editor,url:new URL('/about/',Astro.site!).href},citation:a.sources.map(s=>s.url)};
---
<Base title={a.title} description={a.description} schema={schema} crumbs={[{name:'전체 글',url:'/articles/'},{name:a.title,url:articleUrl(article.id)}]}><header class="article-heading"><p class="eyebrow">{site.tag}</p><h1>{a.title}</h1><p class="description">{a.description}</p><div class="article-meta"><span>편집 {site.editor}</span><span>발행 <time datetime={a.publishedAt}>{a.publishedAt}</time></span><span>수정 <time datetime={a.updatedAt}>{a.updatedAt}</time></span></div></header><div class="reading-grid"><nav class="toc" aria-label="본문 목차"><strong>이 글의 목차</strong><a href="#answer">핵심 답변</a><a href="#scope">적용 범위</a><a href="#body">본문·확인표</a><a href="#faq">관련 질문</a><a href="#sources">공식 근거</a><a href="#related">연결 안내</a></nav><article class="reading"><section id="answer" class="answer-box"><h2>핵심 답변</h2><p>{a.answer}</p></section><section id="scope" class="scope"><h2>적용 범위와 주의사항</h2><p>{a.scope}</p></section><section id="body"><Content/></section><section id="faq" class="faq"><h2>관련 질문과 답변</h2>{a.faq.map(f=><details><summary>{f.q}</summary><p>{f.a}</p></details>)}</section><section id="sources"><h2>공식 근거와 확인 경로</h2><p>자료 확인일 <time datetime={a.checkedAt}>{a.checkedAt}</time> · 글 수정일과 구분합니다.</p><ul class="sources">{a.sources.map(s=><li><a href={s.url} target="_blank" rel="noopener noreferrer external">{s.name} ↗</a><small>{s.note}</small></li>)}</ul><p class="small">공식 출처는 해당 기능이나 규정의 근거이며 외부 상담 대상의 자격·시세·결과를 인증하지 않습니다.</p></section><section id="related"><h2>연결해서 확인할 안내</h2><ul class="related-list"><li><a href="/guide/">질문을 정리하는 확인 순서</a></li><li><a href="/topics/basics/">{site.tag} 주제 안내</a></li><li><a href="/about/">자료 해석과 편집 원칙</a></li></ul></section></article></div><ContactCard/></Base>